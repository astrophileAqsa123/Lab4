pipeline {
  agent any

  stages {

    stage('Build') {
      agent {
        docker {
          image 'composer:2'
          args '-e COMPOSER_HOME=/tmp/composer'
        }
      }
      steps {
        echo 'Build stage running inside a Composer/PHP container'
        sh 'php --version'
        sh 'composer install --no-interaction --prefer-dist --no-scripts --ignore-platform-reqs'
      }
    }

    stage('Test') {
      agent {
        docker {
          image 'composer:2'
          args '-e COMPOSER_HOME=/tmp/composer'
        }
      }
      steps {
        echo 'Test stage running inside a Composer/PHP container'
        sh 'composer install --no-interaction --prefer-dist --no-scripts --ignore-platform-reqs'
        sh 'cp .env.example .env'
        sh 'php artisan key:generate'
        sh 'php artisan test'
      }
    }

    stage('Deploy') {
      steps {
        echo 'Deploy stage running on EC2 using host Docker'
        sh 'docker build -t laravel-app:latest .'
        sh 'docker rm -f laravel-container || true'
        sh 'docker run -d -p 8000:8000 --name laravel-container laravel-app:latest'
      }
    }
  }
}
